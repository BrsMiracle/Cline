{
  "name": "lumen65",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LUMEN 65 — interactive 3D mechanical keyboard product page (Three.js + React + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build && node tools/build-single.mjs",
    "verify": "node tools/verify.mjs",
    "verify:single": "node tools/verify.mjs --file lumen-65.html"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
